# The tailnet URL of this Mac from `tailscale serve`, for example https://my-mac.tail1234.ts.net.
# Remote access stays off while this is empty. Restart both servers after a change.
PI_UI_REMOTE_URL=

# Voice input: the Target URI of the Azure OpenAI gpt-4o-transcribe deployment, for example
# https://<resource>.openai.azure.com/openai/deployments/<deployment>/audio/transcriptions?api-version=2025-03-01-preview
# Voice input gives an error while this or PI_UI_TRANSCRIBE_KEY is empty. Restart both servers after a change.
PI_UI_TRANSCRIBE_URL=
# The API key of the deployment. Only the server uses it.
PI_UI_TRANSCRIBE_KEY=
